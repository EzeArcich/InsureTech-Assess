APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dash_roles
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

INSPECTION_GEOCODING_URL=https://nominatim.openstreetmap.org/search
INSPECTION_GEOCODING_COUNTRY=ar

# Laboratorio de aseguradoras (sólo local/testing; API en proceso HTTP separado)
CLAIM_SIMULATOR_ENABLED=false
CLAIM_SIMULATOR_ORIGIN=http://127.0.0.1:8001

# Motor autónomo: cola database/simulations; fallas opt-in sólo de laboratorio
CLAIM_SIMULATION_HTTP_TIMEOUT=8
CLAIM_SIMULATION_MAX_ATTEMPTS=4
CLAIM_SIMULATION_FAULTS_ENABLED=false

# Opcional: binario PHP CLI para el botón Encender motor (por defecto PHP_BINDIR/php)
# CLAIM_SIMULATION_PHP_BINARY=/usr/bin/php
